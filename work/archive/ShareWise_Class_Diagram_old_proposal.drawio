</mxGeometry></mxCell><mxCell id="E" value="Expense context · core · hexagonal" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fillColor=#F3F6FC;strokeColor=#2A63C6;fontColor=#2A63C6;" vertex="1" parent="1"><mxGeometry x="1500" y="0" width="1180" height="760" as="geometry"/></mxCell><mxCell id="GroupRoster" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Snapshot · fed by Group events (ACL)»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupRoster&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ groupId: GroupId&lt;br/&gt;+ open: boolean&lt;br/&gt;+ currency: Currency&lt;br/&gt;+ activeMembers: Set&amp;lt;MemberId&amp;gt;&lt;br/&gt;+ admins: Set&amp;lt;MemberId&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ isActiveMember(m): boolean&lt;br/&gt;+ isAdmin(m): boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#F4F4F4;strokeColor=#777777;dashed=1;" vertex="1" parent="E"><mxGeometry x="20" y="60" width="230" height="163" as="geometry"/></mxCell><mxCell id="Expense" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Expense&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: ExpenseId&lt;br/&gt;+ groupId: GroupId&lt;br/&gt;+ recordedBy: MemberId&lt;br/&gt;+ title: ExpenseTitle&lt;br/&gt;+ date: LocalDate&lt;br/&gt;+ amount: Money&lt;br/&gt;+ paidBy: MemberId&lt;br/&gt;+ split: Split&lt;br/&gt;+ status: ExpenseStatus&lt;br/&gt;+ history: List&amp;lt;ExpenseRevision&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ record(roster, recorder, title, date, amount, payer, split): ExpenseRecorded&lt;br/&gt;+ correct(roster, by, newVersion, reason): ExpenseCorrected&lt;br/&gt;+ remove(roster, by): ExpenseRemoved&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="E"><mxGeometry x="290" y="60" width="538" height="253" as="geometry"/></mxCell><mxCell id="ExpenseEvents" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Events»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Expense events&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ExpenseRecorded&lt;br/&gt;ExpenseCorrected&lt;br/&gt;ExpenseRemoved&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#EEE8FB;strokeColor=#6A4FB3;" vertex="1" parent="E"><mxGeometry x="878" y="60" width="190" height="93" as="geometry"/></mxCell><mxCell id="nE" value="&lt;b&gt;Invariants inside:&lt;/b&gt; R1 amount &amp;gt; 0 · R3 ≥1 participant, nobody twice · R3a someone other than the payer · R4 shares = amount · R7 history kept · R8 REMOVED is final.&lt;br/&gt;&lt;b&gt;Via GroupRoster:&lt;/b&gt; R2 R3 R5 R6 R7a." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFDF2;strokeColor=#B8A77A;" vertex="1" parent="E"><mxGeometry x="878" y="190" width="240" height="150" as="geometry"/></mxCell><mxCell id="ExpenseTitle" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ExpenseTitle&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: String (1–80)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="E"><mxGeometry x="20" y="383" width="170" height="63" as="geometry"/></mxCell><mxCell id="Split" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Split&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ strategy: SplitStrategy&lt;br/&gt;+ shares: List&amp;lt;Share&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ equal(amount, participants): Split&lt;br/&gt;+ exact(amount, amounts): Split&lt;br/&gt;+ byPercentage(amount, percentages): Split&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="E"><mxGeometry x="220" y="383" width="270" height="133" as="geometry"/></mxCell><mxCell id="ExpenseStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ExpenseStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ACTIVE&lt;br/&gt;CORRECTED&lt;br/&gt;REMOVED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="E"><mxGeometry x="520" y="383" width="150" height="93" as="geometry"/></mxCell><mxCell id="ExpenseRevision" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ExpenseRevision&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ revision: int&lt;br/&gt;+ previous title, amount, payer, date, split&lt;br/&gt;+ correctedBy: MemberId&lt;br/&gt;+ correctedAt: Instant&lt;br/&gt;+ reason: String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="E"><mxGeometry x="700" y="383" width="280" height="123" as="geometry"/></mxCell><mxCell id="Share" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Share&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ participant: MemberId&lt;br/&gt;+ amount: Money&lt;br/&gt;+ percentage: Percentage [0..1]&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="E"><mxGeometry x="220" y="543" width="230" height="93" as="geometry"/></mxCell><mxCell id="SplitStrategy" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;SplitStrategy&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;EQUAL&lt;br/&gt;EXACT&lt;br/&gt;PERCENTAGE&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="E"><mxGeometry x="520" y="543" width="150" height="93" as="geometry"/></mxCell><mxCell id="Percentage" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Perc