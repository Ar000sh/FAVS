<mxfile host="app.diagrams.net"><diagram id="sharewise-team" name="ShareWise team model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;ShareWise – class diagram (team version 17.10.26)&lt;/b&gt;&lt;br/&gt;Dashed boxes = aggregates (one transaction each). Aggregates refer to each other by ID only and react to each other&#x27;s domain events (DDD slides 64–71). Purple dashed arrow = publishes, orange dashed arrow = subscribes to, ◆ = composition (part of the aggregate), grey dashed = uses / references by ID. Colours: cyan aggregate root, blue entity, green value object, yellow enumeration, pink read model, purple domain events." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="-130" width="1500" height="100" as="geometry"/></mxCell><mxCell id="G" value="Group context · supporting · layered" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#FAF6EC;strokeColor=#86681A;fontColor=#86681A;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1104" height="820" as="geometry"/></mxCell><mxCell id="AG" value="«Aggregate» Group · consistency boundary = 1 transaction" style="rounded=1;arcSize=2;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#0E8FA3;fontColor=#0E8FA3;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="G"><mxGeometry x="20" y="50" width="798" height="740" as="geometry"/></mxCell><mxCell id="Group" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Group&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: GroupId&lt;br/&gt;+ name: GroupName&lt;br/&gt;+ currency: Currency&lt;br/&gt;+ status: GroupStatus&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ createGroup(): GroupCreated&lt;br/&gt;+ inviteMember(Email, UserId adminOrMember): MemberInvited&lt;br/&gt;+ promoteToAdmin(UserId targetMember, UserId actingAdmin): MemberPromoted&lt;br/&gt;+ removeMember(UserId targetMember, UserId actingAdmin): MemberRemoved&lt;br/&gt;+ leaveGroup(UserId member): MemberLeft&lt;br/&gt;+ closeForSettlement(UserId actingAdmin): GroupClosedForSettlement&lt;br/&gt;+ reopenGroup(UserId actingAdmin): GroupReopened&lt;br/&gt;+ archiveGroup(UserId actingAdmin): GroupArchived&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="AG"><mxGeometry x="20" y="50" width="539" height="240" as="geometry"/></mxCell><mxCell id="Membership" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Membership&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ userId: UserId&lt;br/&gt;+ role: GroupRole&lt;br/&gt;+ status: MembershipStatus&lt;br/&gt;+ hasZeroBalance: boolean&lt;br/&gt;+ joinedAt: Instant&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DCE8FB;strokeColor=#2A63C6;" vertex="1" parent="AG"><mxGeometry x="20" y="370" width="210" height="125" as="geometry"/></mxCell><mxCell id="GroupStatus" value="&lt;p style=&quot;margin:0px;margin