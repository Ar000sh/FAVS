i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Expense&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: ExpenseId&lt;br/&gt;+ groupId: GroupId&lt;br/&gt;+ paidBy: UserId&lt;br/&gt;+ recordedBy: UserId&lt;br/&gt;+ title: ExpenseTitle&lt;br/&gt;+ totalAmount: Money&lt;br/&gt;+ splitStrategy: SplitStrategy&lt;br/&gt;+ status: ExpenseStatus&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ record(GroupMembershipView view, GroupId groupId, ExpenseTitle title,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;UserId paidBy, UserId recordedBy, Money totalAmount,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;List&amp;lt;ExpenseShare&amp;gt; shares, SplitStrategy splitStrategy): ExpenseRecorded&lt;br/&gt;+ correct(GroupMembershipView view, Money newAmount, List&amp;lt;ExpenseShare&amp;gt; newShares,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;String reason, UserId actor): ExpenseCorrected&lt;br/&gt;+ remove(GroupMembershipView view, UserId actor): ExpenseRemoved&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="AE"><mxGeometry x="20" y="50" width="602" height="270" as="geometry"/></mxCell><mxCell id="ExpenseShare" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ExpenseShare&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ participantId: UserId&lt;br/&gt;+ owedShare: Money&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strok