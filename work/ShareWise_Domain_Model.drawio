<mxfile host="app.diagrams.net"><diagram id="sharewise-team" name="ShareWise team model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="2400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:18px&#x27;&gt;ShareWise – class diagram (team version 17.10.26)&lt;/b&gt;&lt;br/&gt;Dashed boxes = aggregates (one transaction each). Aggregates refer to each other by ID only and react to each other&#x27;s domain events (DDD slides 64–71). Purple dashed arrow = publishes, orange dashed arrow = subscribes to, ◆ = composition (part of the aggregate), grey dashed = uses / references by ID. Colours: cyan aggregate root, blue entity, green value object, yellow enumeration, pink read model, purple domain events." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="-130" width="1500" height="100" as="geometry"/></mxCell><mxCell id="G" value="Group context · supporting · layered" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;fillColor=#FAF6EC;strokeColor=#86681A;fontColor=#86681A;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1145" height="975" as="geometry"/></mxCell><mxCell id="AG" value="«Aggregate» Group · consistency boundary = 1 transaction" style="rounded=1;arcSize=2;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#0E8FA3;fontColor=#0E8FA3;dashed=1;dashPattern=8 4;strokeWidth=2;" vertex="1" parent="G"><mxGeometry x="20" y="50" width="735" height="895" as="geometry"/></mxCell><mxCell id="Group" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Group&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: GroupId&lt;br/&gt;+ name: GroupName&lt;br/&gt;+ currency: Currency&lt;br/&gt;+ status: GroupStatus&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ createGroup(): GroupCreated&lt;br/&gt;+ inviteMember(Email, UserId adminOrMember): MemberInvited&lt;br/&gt;+ promoteToAdmin(UserId targetMember, UserId actingAdmin): MemberPromoted&lt;br/&gt;+ removeMember(UserId targetMember, UserId actingAdmin): MemberRemoved&lt;br/&gt;+ leaveGroup(UserId member): MemberLeft&lt;br/&gt;+ closeForSettlement(UserId actingAdmin): GroupClosedForSettlement&lt;br/&gt;+ reopenGroup(UserId actingAdmin): GroupReopened&lt;br/&gt;+ archiveGroup(UserId actingAdmin): GroupArchived&lt;br/&gt;+ acceptInvitation(InvitationId, UserId): MemberJoined&lt;br/&gt;+ declineInvitation(InvitationId): InvitationDeclined&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="AG"><mxGeometry x="20" y="50" width="539" height="270" as="geometry"/></mxCell><mxCell id="Membership" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Membership&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ userId: UserId&lt;br/&gt;+ role: GroupRole&lt;br/&gt;+ status: MembershipStatus&lt;br/&gt;+ hasZeroBalance: boolean&lt;br/&gt;+ joinedAt: Instant&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DCE8FB;strokeColor=#2A63C6;" vertex="1" parent="AG"><mxGeometry x="20" y="400" width="210" height="125" as="geometry"/></mxCell><mxCell id="GroupStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;OPEN&lt;br/&gt;CLOSED_FOR_SETTLEMENT&lt;br/&gt;ARCHIVED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="AG"><mxGeometry x="280" y="400" width="175" height="95" as="geometry"/></mxCell><mxCell id="Invitation" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Invitation&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: InvitationId&lt;br/&gt;+ email: Email&lt;br/&gt;+ status: InvitationStatus&lt;br/&gt;+ expiresAt: Instant&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ accept(UserId user)&lt;br/&gt;+ decline()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DCE8FB;strokeColor=#2A63C6;" vertex="1" parent="AG"><mxGeometry x="505" y="400" width="210" height="150" as="geometry"/></mxCell><mxCell id="MembershipStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;MembershipStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ACTIVE&lt;br/&gt;FORMER_MEMBER&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="AG"><mxGeometry x="20" y="630" width="182" height="80" as="geometry"/></mxCell><mxCell id="GroupRole" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupRole&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ADMIN&lt;br/&gt;MEMBER&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="AG"><mxGeometry x="232" y="630" width="154" height="80" as="geometry"/></mxCell><mxCell id="InvitationStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;InvitationStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;PENDING&lt;br/&gt;ACCEPTED&lt;br/&gt;DECLINED&lt;br/&gt;EXPIRED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="AG"><mxGeometry x="519" y="630" width="182" height="110" as="geometry"/></mxCell><mxCell id="GroupName" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupName&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="AG"><mxGeometry x="20" y="800" width="154" height="65" as="geometry"/></mxCell><mxCell id="Email" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Email&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="AG"><mxGeometry x="214" y="800" width="154" height="65" as="geometry"/></mxCell><mxCell id="InvitationId" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;InvitationId&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: UUID&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="AG"><mxGeometry x="408" y="800" width="154" height="65" as="geometry"/></mxCell><mxCell id="GroupDomainEvents" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Events»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupDomainEvents&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;GroupCreated&lt;br/&gt;MemberInvited&lt;br/&gt;MemberJoined&lt;br/&gt;MemberLeft&lt;br/&gt;MemberRemoved&lt;br/&gt;MemberPromoted&lt;br/&gt;InvitationDeclined&lt;br/&gt;GroupClosedForSettlement&lt;br/&gt;GroupReopened&lt;br/&gt;GroupArchived&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#EEE8FB;strokeColor=#6A4FB3;" vertex="1" parent="G"><mxGeometry x="815" y="100" width="196" height="200" as="geometry"/></mxCell><mxCell id="noteInvite" value="&lt;b&gt;Decision 17.10: invitations go through the root&lt;/b&gt;&lt;br/&gt;What: Group.acceptInvitation() checks that the group is OPEN and the user is not yet a member, calls invitation.accept() (PENDING, not expired), adds the Membership and publishes MemberJoined. declineInvitation() works the same way. Invitation keeps accept() / decline(), but they only change its status.&lt;br/&gt;Why: aggregate rule 1 (DDD slide 67): rules that involve several parts are protected via the root. Events are published by the aggregate (slide 71), not by an inner entity." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=11;fillColor=#FFFDF2;strokeColor=#B8A77A;" vertex="1" parent="G"><mxGeometry x="815" y="350" width="300" height="175" as="geometry"/></mxCell><mxCell id="e1" value="manages" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.195;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="Membership" target="Group"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1s" value="1..*" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e1"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="-6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e1t" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e1"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.645;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="GroupStatus" target="Group"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2s" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="-6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e2t" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e2"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e3" value="tracks" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.920;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="Invitation" target="Group"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3s" value="0..*" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e3"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="-6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e3t" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e3"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e4" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.433;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="MembershipStatus" target="Membership"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4s" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e4"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="-6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e4t" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e4"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e5" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.920;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" source="GroupRole" target="Membership"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5s" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e5"><mxGeometry x="-0.8" relative="1" as="geometry"><mxPoint x="-6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e5t" value="1" style="edgeLabel;resizable=0;html=1;fontSize=10;labelBackgroundColor=none;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e5"><mxGeometry x="0.8" relative="1" as="geometry"><mxPoint x="6" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="e6" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=8;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0.500;exitY=0.000;exitDx=0;exitDy=0;entryX=0.500;entryY=1.000;entryDx=0;entryDy=0;" edge="1" parent="1" so