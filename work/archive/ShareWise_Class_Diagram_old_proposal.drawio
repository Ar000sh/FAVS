nalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#C0410D;fontColor=#C0410D;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="GroupEvents" target="BalanceSheet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1235" y="800"/><mxPoint x="413.6" y="800"/></Array></mxGeometry></mxCell><mxCell id="e35" value="ExpenseRecorded / Corrected / Removed → apply / replace / revert (via ExpenseEffect)" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#C0410D;fontColor=#C0410D;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ExpenseEvents" target="BalanceSheet"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2650" y="92.0"/><mxPoint x="2650" y="780"/><mxPoint x="487.4" y="780"/></Array></mxGeometry></mxCell><mxCell id="K" value="Shared kernel · used by Expense and Settlement (context map #4b)" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fillColor=#F7F7F7;strokeColor=#888888;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1500" y="860" width="1180" height="300" as="geometry"/></mxCell><mxCell id="Money" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Money&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ amount: BigDecimal (scale 2)&lt;br/&gt;+ currency: Currency&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ plus(Money): Money&lt;br/&gt;+ minus(Money): Money&lt;br/&gt;+ negate(): Money&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="K"><mxGeometry x="30" y="60" width="240" height="133" as="geometry"/></mxCell><mxCell id="Currency" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Currency&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ code: String (ISO 4217, e.g. EUR)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="K"><mxGeometry x="330" y="60" width="240" height="63" as="geometry"/></mxCell><mxCell id="TypedIds" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Objects»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Typed IDs&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;GroupId&lt;br/&gt;MemberId&lt;br/&gt;UserId&lt;br/&gt;ExpenseId&lt;br/&gt;InvitationId&lt;br/&gt;SettlementPaymentId&lt;br/&gt;(each wraps a UUID)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="K"><mxGeometry x="630" y="60" width="220" height="153" as="geometry"/></mxCell><mxCell id="nK" value="Money refuses to add two different currencies (G2). One currency per group, no conversion.&lt;br/&gt;Typed IDs are how aggregates point at each other (slide 67, rule 3); a MemberId can’t be passed where a GroupId belongs." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFDF2;strokeColor=#B8A77A;" vertex="1" parent="K"><mxGeometry x="880" y="60" width="270" height="120" as="geometry"/></mxCell><mxCell id="e36" value="" style="html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="Currency" target="Money"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e36s" value="1" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=bottom;fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="e36"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="-4" y="-2" as="offset"/></mxGeometry></mxCell><mxCell id="O" value="Activity (read model) · Notification (generic): listen to every event, own no aggregate" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fillColor=#F1F5F2;strokeColor=#55675A;fontColor=#55675A;" vertex="1" parent="1"><mxGeometry x="1500" y="1220" width="1180" height="300" as="geometry"/></mxCell><mxCell id="ActivityEntry" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Read model (CQRS, slide 78)»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ActivityEntry&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ groupId · eventType · at · text&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E7EDE8;strokeColor=#55675A;dashed=1;" vertex="1" parent="O"><mxGeometry x="30" y="60" width="260" height="63" as="geometry"/></mxCell><mxCell id="Notification" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Generic delivery»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Notification&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ recipient · channel · text&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E7EDE8;strokeColor=#55675A;dashed=1;" vertex="1" parent="O"><mxGeometry x="330" y="60" width="260" height="63" as="geometry"/></mxCell><mxCell id="nO" value="Subscribes to the Group, Expense and Settlement events (Conformist, context map #6 and #7). Not part of the tactical model: no invariants, nothing changes it except incoming events." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFDF2;strokeColor=#B8A77A;" vertex="1" parent="O"><mxGeometry x="630" y="60" width="520" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>