<mxfile host="app.diagrams.net">
  <diagram name="Page-7" id="gu9ajPQJ9kTLHtV0NTDo">
    <mxGraphModel dx="1414" dy="1912" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==========================================\n    %% SHARED KERNEL\n    %% ==========================================\n    namespace SharedKernel {\n        class Money {\n            &lt;&lt;Value Object&gt;&gt;\n            +BigDecimal amount\n            +Currency currency\n            +add(Money) Money\n            +subtract(Money) Money\n            +negate() Money\n            +isPositive() boolean\n            +isZero() boolean\n        }\n        class GroupId {\n            &lt;&lt;Value Object&gt;&gt;\n            +UUID value\n        }\n        class UserId {\n            &lt;&lt;Value Object&gt;&gt;\n            +UUID value\n        }\n    }\n\n    %% ==========================================\n    %% EXPENSE CONTEXT (CORE)\n    %% ==========================================\n    namespace ExpenseContext {\n        class Expense {\n            &lt;&lt;Aggregate Root&gt;&gt;\n            +ExpenseId id\n            +GroupId groupId\n            +UserId paidBy\n            +UserId recordedBy\n            +ExpenseTitle title\n            +Money totalAmount\n            +SplitStrategy splitStrategy\n            +ExpenseStatus status\n            +record(GroupId, UserId, Money, List~ExpenseShare~, SplitStrategy) ExpenseRecorded\n            +correct(Money newAmount, List~ExpenseShare~ newShares, String reason, UserId actor) ExpenseCorrected\n            +remove(UserId actor) ExpenseRemoved\n        }\n\n        class ExpenseShare {\n            &lt;&lt;Value Object&gt;&gt;\n            +UserId participantId\n            +Money owedShare\n            +Percentage percentage\n        }\n\n        class ExpenseRevision {\n            &lt;&lt;Value Object&gt;&gt;\n            +Money previousAmount\n            +List~ExpenseShare~ previousShares\n            +Instant correctedAt\n            +UserId correctedBy\n            +String reason\n        }\n\n        class SplitStrategy {\n            &lt;&lt;Enumeration&gt;&gt;\n            EQUAL\n            EXACT\n            PERCENTAGE\n        }\n\n        class ExpenseStatus {\n            &lt;&lt;Enumeration&gt;&gt;\n            ACTIVE\n            CORRECTED\n            REMOVED\n        }\n\n        class ExpenseDomainEvents {\n            &lt;&lt;Domain Events&gt;&gt;\n            ExpenseRecorded\n            ExpenseCorrected\n            ExpenseRemoved\n        }\n    }\n\n    Expense \&quot;1\&quot; *-- \&quot;1..*\&quot; ExpenseShare : splits into\n    Expense \&quot;1\&quot; *-- \&quot;0..*\&quot; ExpenseRevision : maintains history\n    Expense \&quot;1\&quot; *-- \&quot;1\&quot; SplitStrategy\n    Expense \&quot;1\&quot; *-- \&quot;1\&quot; ExpenseStatus\n    Expense \&quot;1\&quot; *-- \&quot;1\&quot; Money : totalAmount\n    Expense ..&gt; GroupId : references by ID\n    Expense ..&gt; UserId : references by ID\n    Expense ..&gt; ExpenseDomainEvents : publishes\n\n    %% ==========================================\n    %% SETTLEMENT CONTEXT (CORE - LEDGER &amp; CQRS)\n    %% ==========================================\n    namespace SettlementContext {\n        class GroupLedger {\n            &lt;&lt;Aggregate Root&gt;&gt;\n            +GroupId groupId\n            +appendExpenseEntry(ExpenseRecorded)\n            +appendCorrectionReversal(ExpenseCorrected)\n            +appendRemovalReversal(ExpenseRemoved)\n            +appendSettlementPayment(SettlementPaymentConfirmed)\n            +appendDebtWaiver(DebtForgiven)\n            +projectBalances() List~MemberBalance~\n            +projectSimplifiedPlan() SettlementPlan\n        }\n\n        class LedgerEntry {\n            &lt;&lt;Value Object&gt;&gt;\n            +EntryId id\n            +UserId userId\n            +Money deltaAmount\n            +LedgerEntryType type\n            +String referenceId\n            +Instant occurredAt\n        }\n\n        class LedgerEntryType {\n            &lt;&lt;Enumeration&gt;&gt;\n            EXPENSE_PAID\n            EXPENSE_OWED\n            EXPENSE_REVERSAL\n            PAYMENT_SENT\n            PAYMENT_RECEIVED\n            DEBT_WAIVED\n        }\n\n        class MemberBalance {\n            &lt;&lt;Read Model&gt;&gt;\n            +UserId userId\n            +Money netBalance\n        }\n\n        class SettlementPlan {\n            &lt;&lt;Read Model&gt;&gt;\n            +List~DirectedDebt~ simplifiedDebts\n        }\n\n        class DirectedDebt {\n            &lt;&lt;Value Object&gt;&gt;\n            +UserId fromDebtor\n            +UserId toCreditor\n            +Money amount\n        }\n\n        class SettlementPayment {\n            &lt;&lt;Aggregate Root&gt;&gt;\n            +SettlementPaymentId id\n            +GroupId groupId\n            +UserId fromDebtor\n            +UserId toCreditor\n            +Money amount\n            +PaymentStatus status\n            +record(Money openDebt) SettlementPaymentRecorded\n            +confirm(UserId creditor) SettlementPaymentConfirmed\n            +reject(UserId creditor) SettlementPaymentRejected\n            +waive(UserId creditor, String note) DebtForgiven\n        }\n\n        class PaymentStatus {\n            &lt;&lt;Enumeration&gt;&gt;\n            PENDING\n            CONFIRMED\n            REJECTED\n            WAIVED\n        }\n\n        class SettlementDomainEvents {\n            &lt;&lt;Domain Events&gt;&gt;\n            SettlementPaymentRecorded\n            SettlementPaymentConfirmed\n            SettlementPaymentRejected\n            DebtForgiven\n            MemberBalanceStatusChanged\n            AllBalancesSettled\n        }\n    }\n\n    GroupLedger \&quot;1\&quot; *-- \&quot;0..*\&quot; LedgerEntry : append-only entries\n    LedgerEntry \&quot;1\&quot; *-- \&quot;1\&quot; LedgerEntryType\n    GroupLedger ..&gt; MemberBalance : projects\n    GroupLedger ..&gt; SettlementPlan : computes\n    SettlementPlan \&quot;1\&quot; *-- \&quot;0..*\&quot; DirectedDebt\n    SettlementPayment \&quot;1\&quot; *-- \&quot;1\&quot; PaymentStatus\n    SettlementPayment \&quot;1\&quot; *-- \&quot;1\&quot; Money : amount\n    SettlementPayment ..&gt; SettlementDomainEvents : publishes\n    GroupLedger ..&gt; SettlementDomainEvents : publishes AllBalancesSettled\n\n    %% ==========================================\n    %% GROUP CONTEXT (SUPPORTING)\n    %% ==========================================\n    namespace GroupContext {\n        class Group {\n            &lt;&lt;Aggregate Root&gt;&gt;\n            +GroupId id\n            +GroupName name\n            +Currency currency\n            +GroupStatus status\n            +inviteMember(Email, UserId adminOrMember) MemberInvited\n            +promoteToAdmin(UserId targetMember, UserId actingAdmin) MemberPromoted\n            +removeMember(UserId targetMember, UserId actingAdmin) MemberRemoved\n            +leaveGroup(UserId member) MemberLeft\n            +closeForSettlement(UserId actingAdmin) GroupClosedForSettlement\n            +reopenGroup(UserId actingAdmin) GroupReopened\n            +archiveGroup(UserId actingAdmin) GroupArchived\n        }\n\n        class Membership {\n            &lt;&lt;Entity&gt;&gt;\n            +UserId userId\n            +GroupRole role\n            +MembershipStatus status\n            +boolean hasZeroBalance\n            +Instant joinedAt\n        }\n\n        class GroupRole {\n            &lt;&lt;Enumeration&gt;&gt;\n            ADMIN\n            MEMBER\n        }\n\n        class MembershipStatus {\n            &lt;&lt;Enumeration&gt;&gt;\n            ACTIVE\n            FORMER_MEMBER\n        }\n\n        class Invitation {\n            &lt;&lt;Entity&gt;&gt;\n            +InvitationId id\n            +Email email\n            +InvitationStatus status\n            +Instant expiresAt\n            +accept(UserId user) MemberJoined\n            +decline() InvitationDeclined\n        }\n\n        class GroupStatus {\n            &lt;&lt;Enumeration&gt;&gt;\n            OPEN\n            CLOSED_FOR_SETTLEMENT\n            ARCHIVED\n        }\n\n        class GroupDomainEvents {\n            &lt;&lt;Domain Events&gt;&gt;\n            GroupCreated\n            MemberInvited\n            MemberJoined\n            MemberLeft\n            MemberRemoved\n            MemberPromoted\n            GroupClosedForSettlement\n            GroupReopened\n            GroupArchived\n        }\n    }\n\n    Group \&quot;1\&quot; *-- \&quot;1..*\&quot; Membership : manages\n    Membership \&quot;1\&quot; *-- \&quot;1\&quot; GroupRole\n    Membership \&quot;1\&quot; *-- \&quot;1\&quot; MembershipStatus\n    Group \&quot;1\&quot; *-- \&quot;0..*\&quot; Invitation : tracks\n    Group \&quot;1\&quot; *-- \&quot;1\&quot; GroupStatus\n    Group ..&gt; GroupDomainEvents : publishes\n\n    %% ==========================================\n    %% EVENT SUBSCRIPTIONS\n    %% ==========================================\n    GroupLedger ..&gt; ExpenseDomainEvents : subscribes to\n    GroupLedger ..&gt; SettlementDomainEvents : subscribes to\n    Group ..&gt; SettlementDomainEvents : subscribes to&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="hCQeS1Rk4ec1oHEpOPA0-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
