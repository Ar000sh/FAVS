<mxfile host="app.diagrams.net"><diagram id="sharewise-ex3" name="ShareWise tactical model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;ShareWise – tactical model (Ex3)&lt;/b&gt;&lt;br/&gt;Entities, value objects, aggregates and domain events per bounded context. Draft 17.10.26.&lt;br/&gt;Our decisions applied: Share is a VO, not the slide-64 ExpenseParticipant entity (D1) · Expense and Settlement store MemberId, not UserId (D3) · Expense checks group rules against a GroupRoster snapshot (D4) · BalanceSheet is an aggregate (D5) · Invitation is its own aggregate (D6) · SettlementPlan is computed, never stored (D7). Slides: 02.DDD 64–69, 71." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFDF2;strokeColor=#B8A77A;" vertex="1" parent="1"><mxGeometry x="0" y="-330" width="760" height="120" as="geometry"/></mxCell><mxCell id="leg" value="Legend" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fillColor=#F7F7F7;strokeColor=#888888;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="1450" y="-330" width="560" height="210" as="geometry"/></mxCell><mxCell id="lgroot" value="Aggregate root (entity, one transaction)" style="rounded=0;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="leg"><mxGeometry x="14" y="40" width="250" height="24" as="geometry"/></mxCell><mxCell id="lgentity" value="Entity inside an aggregate" style="rounded=0;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#DCE8FB;strokeColor=#2A63C6;" vertex="1" parent="leg"><mxGeometry x="14" y="72" width="250" height="24" as="geometry"/></mxCell><mxCell id="lgvo" value="Value object" style="rounded=0;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="leg"><mxGeometry x="14" y="104" width="250" height="24" as="geometry"/></mxCell><mxCell id="lgenum" value="Enumeration (also a value object)" style="rounded=0;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="leg"><mxGeometry x="14" y="136" width="250" height="24" as="geometry"/></mxCell><mxCell id="lgsnap" value="Snapshot / local copy, not an aggregate" style="rounded=0;html=1;align=left;spacingLeft=6;fontSize=11;fillColor=#F4F4F4;strokeColor=#777777;dashed=1;" vertex="1" parent="leg"><mxGeometry x="14" y="168" width="250" height="24" as="geometry"/></mxCell><mxCell id="lgt0" value="composition (part of the aggregate)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="leg"><mxGeometry x="360" y="40" width="190" height="24" as="geometry"/></mxCell><mxCell id="lge0" value="" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=diamondThin;endFill=1;endSize=14;strokeColor=#333333;" edge="1" parent="leg"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="52" as="sourcePoint"/><mxPoint x="350" y="52" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt1" value="reference by ID only (rule 3)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="leg"><mxGeometry x="360" y="80" width="190" height="24" as="geometry"/></mxCell><mxCell id="lge1" value="" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;endSize=10;strokeColor=#777777;fontColor=#555555;" edge="1" parent="leg"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="92" as="sourcePoint"/><mxPoint x="350" y="92" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt2" value="publishes / uses" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="leg"><mxGeometry x="360" y="120" width="190" height="24" as="geometry"/></mxCell><mxCell id="lge2" value="" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;endFill=0;endSize=10;strokeColor=#6A4FB3;fontColor=#6A4FB3;" edge="1" parent="leg"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="132" as="sourcePoint"/><mxPoint x="350" y="132" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lgt3" value="domain event, handled in its own transaction (rule 4)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="leg"><mxGeometry x="360" y="160" width="190" height="24" as="geometry"/></mxCell><mxCell id="lge3" value="" style="html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#C0410D;fontColor=#C0410D;" edge="1" parent="leg"><mxGeometry relative="1" as="geometry"><mxPoint x="285" y="172" as="sourcePoint"/><mxPoint x="350" y="172" as="targetPoint"/></mxGeometry></mxCell><mxCell id="I" value="Identity context · generic · Keycloak (bought)" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fillColor=#F1F5F2;strokeColor=#55675A;fontColor=#55675A;" vertex="1" parent="1"><mxGeometry x="1060" y="-330" width="300" height="150" as="geometry"/></mxCell><mxCell id="User" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«External · not modelled»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;User&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: UserId&lt;br/&gt;+ email · displayName&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E7EDE8;strokeColor=#55675A;dashed=1;" vertex="1" parent="I"><mxGeometry x="30" y="44" width="162" height="78" as="geometry"/></mxCell><mxCell id="G" value="Group context · supporting · layered" style="rounded=1;arcSize=1;container=1;collapsible=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontStyle=1;fontSize=15;fillColor=#FAF6EC;strokeColor=#86681A;fontColor=#86681A;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="760" as="geometry"/></mxCell><mxCell id="Invitation" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Invitation&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: InvitationId&lt;br/&gt;+ groupId: GroupId&lt;br/&gt;+ invitedBy: MemberId&lt;br/&gt;+ email: EmailAddress [0..1]&lt;br/&gt;+ code: InvitationCode&lt;br/&gt;+ validity: ValidityPeriod&lt;br/&gt;+ status: InvitationStatus&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ issue(groupId, inviter, email, now): MemberInvited&lt;br/&gt;+ accept(userId, now): InvitationAccepted&lt;br/&gt;+ decline(now): InvitationDeclined&lt;br/&gt;+ expire(now)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="G"><mxGeometry x="20" y="60" width="367" height="223" as="geometry"/></mxCell><mxCell id="Group" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Group&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: GroupId&lt;br/&gt;+ name: GroupName&lt;br/&gt;+ currency: Currency&lt;br/&gt;+ status: GroupStatus&lt;br/&gt;+ members: List&amp;lt;Member&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ create(name, currency, creator): GroupCreated, MemberJoined&lt;br/&gt;+ join(userId): MemberJoined&lt;br/&gt;+ leave(memberId, balance): MemberLeft&lt;br/&gt;+ removeMember(admin, memberId, balance): MemberRemoved&lt;br/&gt;+ promoteToAdmin(admin, memberId): MemberPromoted&lt;br/&gt;+ closeGroupForSettlement(admin): GroupClosedForSettlement&lt;br/&gt;+ reopenGroup(admin): GroupReopened&lt;br/&gt;+ archiveGroup(admin, allSettled): GroupArchived&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DAF5F9;strokeColor=#0E8FA3;strokeWidth=2;" vertex="1" parent="G"><mxGeometry x="520" y="60" width="426" height="253" as="geometry"/></mxCell><mxCell id="Member" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Member&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ id: MemberId&lt;br/&gt;+ userId: UserId&lt;br/&gt;+ role: MemberRole&lt;br/&gt;+ status: MemberStatus&lt;br/&gt;+ joinedAt: Instant&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#DCE8FB;strokeColor=#2A63C6;" vertex="1" parent="G"><mxGeometry x="1110" y="60" width="230" height="123" as="geometry"/></mxCell><mxCell id="InvitationStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;InvitationStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;PENDING&lt;br/&gt;ACCEPTED&lt;br/&gt;DECLINED&lt;br/&gt;EXPIRED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="G"><mxGeometry x="20" y="383" width="160" height="108" as="geometry"/></mxCell><mxCell id="ValidityPeriod" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;ValidityPeriod&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ issuedAt: Instant&lt;br/&gt;+ validUntil: Instant (+7 days)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ isExpiredAt(now): boolean&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="G"><mxGeometry x="200" y="383" width="220" height="103" as="geometry"/></mxCell><mxCell id="EmailAddress" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;EmailAddress&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="G"><mxGeometry x="200" y="523" width="220" height="63" as="geometry"/></mxCell><mxCell id="InvitationCode" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;InvitationCode&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: String (secret)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="G"><mxGeometry x="20" y="523" width="160" height="63" as="geometry"/></mxCell><mxCell id="GroupName" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupName&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;+ value: String (1–60, not empty)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#E3F4E1;strokeColor=#3C8A3A;" vertex="1" parent="G"><mxGeometry x="520" y="383" width="220" height="63" as="geometry"/></mxCell><mxCell id="GroupStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GroupStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;OPEN&lt;br/&gt;CLOSED_FOR_SETTLEMENT&lt;br/&gt;ARCHIVED&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="G"><mxGeometry x="760" y="383" width="200" height="93" as="geometry"/></mxCell><mxCell id="MemberRole" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;MemberRole&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ADMIN&lt;br/&gt;MEMBER&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="G"><mxGeometry x="1110" y="273" width="110" height="78" as="geometry"/></mxCell><mxCell id="MemberStatus" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;MemberStatus&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;ACTIVE&lt;br/&gt;FORMER&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#FFF6CC;strokeColor=#B8960B;" vertex="1" parent="G"><mxGeometry x="1240" y="273" width="120" height="78" as="geometry"/></mxCell><mxCell id="GroupEvents" value="&lt;p style=&quot;margin:0px;margin-top:5px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Events»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Group events&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;GroupCreated&lt;br/&gt;MemberJoined&lt;br/&gt;MemberLeft&lt;br/&gt;MemberRemoved&lt;br/&gt;MemberPromoted&lt;br/&gt;GroupClosedForSettlement&lt;br/&gt;GroupReopened&lt;br/&gt;GroupArchived&lt;br/&gt;MemberInvited&lt;br/&gt;InvitationAccepted&lt;br/&gt;InvitationDeclined&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Helvetica;fillColor=#EEE8FB;strokeColor=#6A4FB3;" vertex="1" parent="G"><mxGeometry x="1110" y="423" width="250" height="213" as="geometry"/></mxCell><mxCell id="nG" value="&lt;b&gt;Why Member is inside Group:&lt;/b&gt; R12 (the last admin can’t leave) needs all admins in one transaction.&lt;br/&gt;&lt;b&gt;Why Invitation is separate:&lt;/b&gt; own lifecycle + 7-day timer; inside Group every invite would lock the group (rule 2).&lt;br/&gt;leave() / removeMember() get the balance from Settlement (R11)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;f